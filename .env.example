# These names must be set as environment variables; this file is not auto-loaded.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set all PostgreSQL values to enable PostgreSQL. Otherwise local SQLite is used.
# POSTGRES_DB=teamflow
# POSTGRES_USER=teamflow
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Production additionally needs DJANGO_SECRET_KEY and HTTPS configuration.
